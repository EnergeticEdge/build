# Postgres (Railway provides DATABASE_URL automatically when you add a Postgres service)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Beehiiv (find these in Beehiiv > Settings > Integrations > API)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Base URL used to build the results page link sent to Beehiiv (e.g. https://theenergeticedge.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
